# Copy to .env (repo root) or backend/.env and fill in.
# Set either key (or both). With both set, Anthropic is used unless LLM_PROVIDER says otherwise.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# LLM_PROVIDER=anthropic   # or openai
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-5.5
# LLM_MAX_ATTEMPTS=3
# LLM_TIMEOUT_SECONDS=120
# Canned reviews from an offline fake of the Messages API; no key or network needed.
# LLM_MOCK=false
# DATABASE_URL=sqlite+aiosqlite:///backend/data/app.db
# CORS_ORIGINS=["http://localhost:5173"]
# LOG_LEVEL=INFO
